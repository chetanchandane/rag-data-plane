# Copy to .env (gitignored) and fill in. Never commit real values.

NEON_ADMIN_URL=         # Neon default owner, dev branch DIRECT endpoint; db/bootstrap.py only
NEON_DEV_ENDPOINT_ID=   # e.g. ep-xxxx-yyyy-12345678; bootstrap refuses any other endpoint
# The three DATABASE_URL_* lines below are written by db/bootstrap.py.

DATABASE_URL_OWNER=     # migrations only
DATABASE_URL_API=       # app_api role, pooled endpoint
DATABASE_URL_INGEST=    # app_ingest role, pooled endpoint
AWS_PROFILE=ragdp         # local only (aws login session); Lambda uses its IAM role
AWS_REGION=us-east-2
EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
RAW_BUCKET=
HONEYCOMB_API_KEY=      # optional: worker.local sends its trace to Honeycomb (dataset ragdp-worker-local)
JWT_ISSUER=             # token issuer URL: terraform -chdir=infra/envs/prod output -raw issuer_url
                        # scripts/issuer.py mint signs for it; api.local verifies tokens against it
